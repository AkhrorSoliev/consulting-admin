rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'super_admin';
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isLimitedAdmin() {
      return request.auth != null && request.auth.token.role == 'limited_admin';
    }

    function hasKey(m, k) {
      return m.keys().hasAny([k]);
    }

    // Limited admin can touch comment, berufserfahrung, and ausbildung fields on existing docs.
    // (UI stores the actual comment in `commentar` and audit metadata in `commentarMeta`.)
    function limitedAdminValidCommentMeta() {
      // In Security Rules, request.resource.data is the full doc after update.
      // So we validate `commentarMeta` ONLY when it is being written/changed.
      return !hasKey(request.resource.data, 'commentarMeta') ||
        (hasKey(resource.data, 'commentarMeta') &&
         request.resource.data.commentarMeta == resource.data.commentarMeta) ||
        (
          request.resource.data.commentarMeta is map &&
          request.resource.data.commentarMeta.keys().hasOnly([
            'updatedAt',
            'updatedByUid',
            'updatedByName',
            'updatedByPhoto'
          ]) &&
          // Limited admins may only attribute edits to themselves.
          request.resource.data.commentarMeta.updatedByUid == request.auth.uid &&
          request.resource.data.commentarMeta.updatedAt is int &&
          request.resource.data.commentarMeta.updatedByName is string &&
          request.resource.data.commentarMeta.updatedByPhoto is string
        );
    }

    function limitedAdminCanUpdate() {
      let diff = request.resource.data.diff(resource.data);
      return diff.removedKeys().size() == 0 &&
             diff.addedKeys().hasOnly(['commentar', 'commentarMeta', 'berufserfahrung', 'ausbildung']) &&
             diff.changedKeys().hasOnly(['commentar', 'commentarMeta', 'berufserfahrung', 'ausbildung']) &&
             limitedAdminValidCommentMeta();
    }

    function isUpdatingReaction() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasAny(['reaction', 'reactionUpdatedAt']);
    }

    function adminCanUpdate() {
      // Regular admin can update anything EXCEPT reaction fields
      return !isUpdatingReaction();
    }

    // Helper function to check if collection is a candidate collection
    // Hardcoded list of candidate collections for public access (DataExchange)
    function isCandidateCollection(collectionName) {
      return collectionName in [
        'krankenpfleger',
        'altenpfleger', 
        'pflegefachkraft',
        'kinderkrankenpfleger',
        'uy-quruvchisi-fachkraft-2026'
      ];
    }

    // ============================================
    // USERS COLLECTION - User profile data sync
    // ============================================
    match /users/{userId} {
      // Any authenticated user can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Any authenticated user can write/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Admins (including limited_admin) can read all user profiles for avatar display
      allow read: if isSuperAdmin() || isAdmin() || isLimitedAdmin();
    }

    // Public read access for candidate_metadata (for DataExchange lookup)
    match /candidate_metadata/{candidateId} {
      allow read: if true;  // Public read to find collection name
      allow write: if isSuperAdmin() || isAdmin();  // Only admins can write
    }

    // Public read access for meta collection (needed for DataExchange fallback)
    match /meta/{metaId} {
      allow read: if true;  // Public read for collection list
      allow write: if isSuperAdmin() || isAdmin();
    }

    // ============================================
    // ALL OTHER COLLECTIONS - with public access for DataExchange
    // Protected collections (users, settings, etc.) are handled above
    // ============================================
    match /{collectionName}/{documentId} {
      // Public read for all collections (needed for DataExchange)
      // Sensitive collections like 'users' are already handled above with specific rules
      allow read: if true;
      
      // Update: admins can update anything, public can only update incomingDocuments
      allow update: if isSuperAdmin() || 
                       (isAdmin() && adminCanUpdate()) ||
                       (isLimitedAdmin() && limitedAdminCanUpdate()) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['incomingDocuments']);
      
      allow create, delete: if isSuperAdmin() || isAdmin();
    }
  }
}